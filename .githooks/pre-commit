#!/bin/sh
# Nothing is committed on main: work goes in a branch and enters through a PR (AGENTS.md › Git).
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "No se commitea en main. Crea una rama (git switch -c slice/S01-nombre) o usa /git:commit." >&2
  exit 1
fi
