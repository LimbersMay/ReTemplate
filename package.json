{
  "name": "re-template",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "init": "node scripts/init.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:once": "ng test --watch=false",
    "dev": "wxt",
    "build:extension": "ng build && wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint src --max-warnings 0",
    "lint:design": "re-design-lint src --max-warnings 0",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "trace": "node scripts/trace.mjs",
    "status": "node scripts/status.mjs",
    "check": "npm run build && npm run lint && npm run lint:design && npm run lint:i18n && npm run test:once"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/lucide": "^32.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.30",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.5",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "re-design": "github:LimbersMay/ReDesign#v2.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  }
}
